# ---- Server ----
PORT=8787
# Public origin used for canonical links and CORS (no trailing slash)
PUBLIC_ORIGIN=https://www.klearway.site
# Where shipments, uploads and leads are stored on disk (default: backend/data)
DATA_DIR=

# ---- Workspace access (pilot access key) ----
# If set, every /api/workspace request must send this key (header x-workspace-key).
# Leave empty ONLY for local development on your own machine.
WORKSPACE_ACCESS_KEY=

# ---- Lead notifications (optional, SMTP) ----
# If these are empty, leads are stored but no email is sent (the API reports notified:false).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_TO=olawale@klearway.site
LEAD_FROM=Klearway <olawale@klearway.site>

# ---- AI extraction via Amazon Bedrock (optional, not yet configured) ----
# Leave AI_PROVIDER empty to use label-based text extraction only.
# Set to "bedrock" only after Bedrock model access is approved in your AWS account.
AI_PROVIDER=
AWS_REGION=
BEDROCK_MODEL_ID=
# AWS credentials are read from the standard AWS credential chain (env, profile or IAM role).
# Never put them in any VITE_ variable.
